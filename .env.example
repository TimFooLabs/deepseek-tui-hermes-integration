# DeepSeek TUI runtime API credentials — template.
#
# Copy to the location your service reads and fill in a generated value.
# Never commit a real token.
#
#   User service (this repo's default):
#     install -m 600 /dev/null ~/.config/deepseek-tui/runtime.env
#   System service (root-owned):
#     sudo install -m 600 -o root -g root /dev/null /etc/deepseek-tui/runtime.env
#
# Generate the token:
#   openssl rand -hex 32
#
# Required by the server unit and by scripts/deepseek-agent.
DEEPSEEK_RUNTIME_TOKEN=replace-with-openssl-rand-hex-32
